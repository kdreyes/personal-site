{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/resume", "destination": "/about", "permanent": true },
    { "source": "/endeavors", "destination": "/about#building", "permanent": true },
    { "source": "/stats", "destination": "/about", "permanent": true },
    { "source": "/blog", "destination": "/archive", "permanent": true },
    { "source": "/contact", "destination": "/about#contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
