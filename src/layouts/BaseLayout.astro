---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/500.css';
import '~/styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { SITE } from '~/site.config';

export interface Props {
  /** Page title. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  topics?: string[];
  canonical?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/og/default.png',
  imageAlt,
  type = 'website',
  published,
  modified,
  topics = [],
  canonical,
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
// Static builds report paths like /about.html; canonical URLs use clean paths (/about).
const path =
  Astro.url.pathname
    .replace(/(^|\/)index\.html$/, '$1')
    .replace(/\.html$/, '')
    .replace(/\/$/, '') || '/';
const canonicalUrl = canonical ?? new URL(path, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — essays, research, and field notes`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="author" href="/about" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title ?? SITE.name} />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && <meta property="article:author" content={`${SITE.url}/about`} />}
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:modified_time" content={(modified ?? published)?.toISOString()} />}
    {type === 'article' && topics.map((t) => <meta property="article:tag" content={t} />)}
    {type === 'profile' && <meta property="profile:first_name" content="Katrina" />}
    {type === 'profile' && <meta property="profile:last_name" content="Delos Reyes" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {import.meta.env.PROD && <Analytics />}
    <script>
      // Privacy-friendly custom events (Vercel Analytics). No-ops if unavailable.
      const track = (name: string, data?: Record<string, string>) => {
        const va = (window as unknown as { va?: (e: string, p: unknown) => void }).va;
        if (typeof va === 'function') va('event', { name, data });
      };
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a');
        if (!a || !a.closest('.prose')) return;
        try {
          const url = new URL(a.href);
          if (url.origin !== location.origin) track('outbound_source_click', { host: url.host, page: location.pathname });
        } catch {}
      });
      document.addEventListener('submit', (e) => {
        if ((e.target as Element | null)?.matches?.('form[data-subscribe]')) track('subscribe', { page: location.pathname });
      });
    </script>
  </body>
</html>
